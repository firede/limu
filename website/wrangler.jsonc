// limu's website, served by Cloudflare as a Worker of static assets alone, without a
// script, as mygo-platinum's is. pnpm build writes it into dist.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "limu",
  "account_id": "1fbbff6fac21a592f99d42ad9920f4a6",
  "compatibility_date": "2026-10-16",
  "assets": { "directory": "./dist", "not_found_handling": "404-page" },
  "routes": [{ "pattern": "limu.firede.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false
}
