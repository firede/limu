{
  "name": "limu-website",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "gen": "go run ./gen",
    "playground": "node scripts/playground.mjs",
    "dev": "go run ./gen && ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "go run ./gen && ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "check": "go run ./gen && ASTRO_TELEMETRY_DISABLED=1 astro check",
    "deploy": "pnpm playground && pnpm build && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.3",
    "@fontsource-variable/hanken-grotesk": "5.3.0",
    "astro": "7.4.1",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.11",
    "@types/node": "22.20.5",
    "sass": "1.105.2",
    "typescript": "6.0.3",
    "wrangler": "4.151.2"
  }
}
