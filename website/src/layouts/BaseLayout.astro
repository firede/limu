---
import hankenLatin from '@fontsource-variable/hanken-grotesk/files/hanken-grotesk-latin-wght-normal.woff2?url';
import '../generated/limu-theme.css';
import '../styles/global.scss';
import { formatPageTitle } from '../lib/page-title';
import { siteDescription } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  markdownPath?: string;
  // For a page that the site does not link to and that should stay out of search results.
  noindex?: boolean;
}

const { title, description = siteDescription, markdownPath, noindex = false } = Astro.props;
const pageTitle = formatPageTitle(title);
const canonicalPath = Astro.url.pathname.replace(/\/index\.html$/, '/').replace(/\.html$/, '');
const canonicalUrl = new URL(canonicalPath, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="preload" href={hankenLatin} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" type="image/svg+xml" href="/icon.svg" />
    <link rel="apple-touch-icon" href="/icon-180.png" />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex" />}
    {markdownPath && <link rel="alternate" type="text/markdown" href={markdownPath} title={`${title ?? 'limu'} as Markdown`} />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <title>{pageTitle}</title>
    <style is:inline>
      html[data-initial-hash] { scroll-behavior: auto; }
      a { color: inherit; text-decoration: none; }
      button.header-action { appearance: none; border: 1px solid transparent; outline: 0; background: transparent; color: inherit; font: inherit; }
    </style>
    <script is:inline>
      // The theme chosen with the switch, set before the page is drawn; none follows the system.
      try {
        const theme = localStorage.getItem('limu-theme');
        if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
      } catch {}
    </script>
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f1f6f5" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0c1618" />
    <script is:inline>
      if (window.location.hash) {
        document.documentElement.dataset.initialHash = '';
        window.addEventListener('load', () => {
          window.requestAnimationFrame(() => {
            window.requestAnimationFrame(() => delete document.documentElement.dataset.initialHash);
          });
        }, { once: true });
      }
    </script>
  </head>
  <body><slot /></body>
</html>

<script>
  import '../scripts/site';
</script>
