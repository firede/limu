---
import DiagramThemeSwitch from '../components/DiagramThemeSwitch.astro';
import ExampleCard from '../components/ExampleCard.astro';
import DocsLayout from '../layouts/DocsLayout.astro';
import { exampleTypeHref, exampleTypes, examplesDescription, examplesTitle, featured } from '../lib/examples';

const headings = exampleTypes.map((t) => ({ depth: 2, slug: t.type, text: t.title }));
---

<DocsLayout current="examples" title={examplesTitle} description={examplesDescription} headings={headings} markdownPath="/examples.md">
  <div data-diagram-scope>
    <DiagramThemeSwitch />
    <p>
      Each type shows one or two examples; its page has them all. The examples are the
      playground's, and each opens in it. Types marked beta are written with -beta, as
      Mermaid may still change them.
    </p>
    {exampleTypes.map((t) => (
      <section class="example-type" aria-labelledby={t.type}>
        <h2 id={t.type}>{t.title}{t.beta && <span class="beta-badge">Beta</span>}</h2>
        <p>{t.description}</p>
        {featured(t).map((example) => <ExampleCard example={example} typeTitle={t.title} />)}
        <p class="example-more"><a href={exampleTypeHref(t.type)}>All {t.examples.length === 1 ? 'of its 1 example' : `${t.examples.length} examples`}<span class="visually-hidden"> of {t.title}</span></a></p>
      </section>
    ))}
  </div>
</DocsLayout>

<script>
  import '../scripts/examples';
</script>
