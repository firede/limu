---
// Draws the examples on the page in Kohu, KohuDark or Default. The diagrams' colors are the
// --limu-* variables, so switching lays nothing out again. Until a theme is chosen, the
// diagrams follow the page's: Kohu in the light, KohuDark in the dark.
const themes = [
  { id: 'kohu', title: 'Kohu' },
  { id: 'kohu-dark', title: 'Kohu Dark' },
  { id: 'default', title: 'Default' },
];
---

<script is:inline>
  // The theme chosen last, set on the content before its diagrams are drawn.
  (() => {
    const scope = document.currentScript.closest('[data-diagram-scope]');
    try {
      const theme = localStorage.getItem('limu-diagram-theme');
      if (scope && (theme === 'kohu' || theme === 'kohu-dark' || theme === 'default')) scope.dataset.diagramTheme = theme;
    } catch {}
  })();
</script>
<div class="diagram-theme">
  <span class="diagram-theme-label" id="diagram-theme-label">Theme</span>
  <div class="segmented-control" style={`--segment-count: ${themes.length}`} role="group" aria-labelledby="diagram-theme-label" data-diagram-theme-switch>
    {themes.map(({ id, title }) => <button type="button" data-diagram-theme-option={id} aria-pressed="false">{title}</button>)}
  </div>
</div>
