---
import Mark from './Mark.astro';
import MobileDocsMenu from './MobileDocsMenu.astro';
import { repositoryUrl, type DocsPageId, type Heading } from '../lib/site';

interface Props {
  current?: DocsPageId;
  headings?: Heading[];
  child?: string;
}

const { current, headings = [], child } = Astro.props;
---

<div class="site-header-slot" data-scroll-header-slot>
  <nav class="site-header" aria-label="Main navigation" data-scroll-header>
    <a class="wordmark" href="/" aria-label="limu home"><Mark size={22} />limu</a>
    <div class="site-header-actions">
      <a class="header-action header-icon" href={repositoryUrl} target="_blank" rel="noopener noreferrer" aria-label="limu on GitHub" title="GitHub">
        <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
          <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.4 5.4 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" />
          <path d="M9 18c-4.51 2-5-2-7-2" />
        </svg>
      </a>
      <button class="header-action header-icon" type="button" data-theme-switch aria-label="Switch between light and dark" title="Light or dark">
        <svg class="theme-icon-dark" aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" />
        </svg>
        <svg class="theme-icon-light" aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" />
        </svg>
      </button>
      <MobileDocsMenu current={current} headings={headings} child={child} />
    </div>
    <a class="sidebar-playground" href="/playground">
      <svg aria-hidden="true" width="12" height="12" viewBox="0 0 24 24"><path d="M7 4.5v15a1 1 0 0 0 1.5.86l12.6-7.5a1 1 0 0 0 0-1.72L8.5 3.64A1 1 0 0 0 7 4.5Z" fill="currentColor" /></svg>
      <span>Playground</span>
    </a>
  </nav>
</div>
