---
import Mark from './Mark.astro';
import HeaderIcons from './HeaderIcons.astro';
import MobileDocsMenu from './MobileDocsMenu.astro';
import type { DocsPageId, Heading } from '../lib/site';

interface Props {
  current?: DocsPageId;
  headings?: Heading[];
  child?: string;
}

const { current, headings = [], child } = Astro.props;
---

<div class="site-header-slot" data-scroll-header-slot>
  <nav class="site-header" aria-label="Main navigation" data-scroll-header>
    <a class="wordmark" href="/" aria-label="limu home"><Mark size={22} />limu</a>
    <div class="site-header-actions">
      <HeaderIcons />
      <MobileDocsMenu current={current} headings={headings} child={child} />
    </div>
    <a class="sidebar-playground" href="/playground">
      <svg aria-hidden="true" width="12" height="12" viewBox="0 0 24 24"><path d="M7 4.5v15a1 1 0 0 0 1.5.86l12.6-7.5a1 1 0 0 0 0-1.72L8.5 3.64A1 1 0 0 0 7 4.5Z" fill="currentColor" /></svg>
      <span>Playground</span>
    </a>
  </nav>
</div>
