---
// limu's mark, inline so that it takes the color of the text it is set beside.
import mark from '../generated/mark.json';

interface Props {
  size?: number;
  class?: string;
}

const { size = 20, class: className } = Astro.props;
---

<svg class:list={['mark', className]} viewBox="0 0 64 64" width={size} height={size} aria-hidden="true" set:html={mark.mark} />
