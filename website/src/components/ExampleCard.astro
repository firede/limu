---
import Drawing from './Drawing.astro';
import { playgroundHref, type Example } from '../lib/examples';

interface Props {
  example: Example;
  typeTitle: string;
  // The id of the card's heading, so that the page's outline can link to it.
  id?: string;
}

const { example, typeTitle, id } = Astro.props;
const href = playgroundHref(example.source);
---

<figure class="example-card" id={id}>
  <figcaption class="example-label">
    <span class="example-title">{example.title}</span>
    <span class="example-actions">
      <button class="text-action" type="button" data-copy-source={example.source}>
        <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path></svg>
        <span>Copy<span class="example-action-long"> source</span></span>
      </button>
      {href && <a class="playground-link text-action" href={href}>
        <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><polygon points="6 3 20 12 6 21 6 3" /></svg>
        <span><span class="playground-link-prefix">Open in </span>Playground</span>
      </a>}
    </span>
  </figcaption>
  <Drawing class="example-figure" drawing={example} label={`${typeTitle}: ${example.title}`} />
</figure>
