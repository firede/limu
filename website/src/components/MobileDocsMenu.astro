---
import DocsNavigation from './DocsNavigation.astro';
import type { DocsPageId, Heading } from '../lib/site';

interface Props {
  current?: DocsPageId;
  headings?: Heading[];
  child?: string;
}

const { current, headings = [], child } = Astro.props;
---

<button
  class="header-action mobile-docs-trigger"
  type="button"
  aria-label="Open documentation menu"
  aria-haspopup="dialog"
  aria-expanded="false"
  aria-controls="mobile-docs-panel"
  data-docs-menu-trigger
>
  <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round">
    <path class="mobile-docs-menu-icon" d="M4 6h16M4 12h16M4 18h16"></path>
    <path class="mobile-docs-close-icon" d="M18 6 6 18M6 6l12 12"></path>
  </svg>
</button>
<div class="mobile-docs-backdrop" data-docs-menu-backdrop hidden>
  <section id="mobile-docs-panel" class="mobile-docs-panel" role="dialog" aria-label="Documentation menu">
    <div class="mobile-docs-content">
      <a class="mobile-docs-playground" href="/playground">
        <span>Playground</span>
      </a>
      <DocsNavigation class="mobile-docs-navigation" current={current} headings={headings} child={child} ariaLabel="Documentation menu" />
    </div>
  </section>
</div>
